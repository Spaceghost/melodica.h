-- Candidate: structural scanner with a 64-bit FNV-1a prefilter for keys.
require 'src.value'
require 'src.protocol'

local OK: cint <comptime> = 0
local NOT_FOUND: cint <comptime> = 1
local INVALID_JSON: cint <comptime> = 2
local BAD_ARGUMENT: cint <comptime> = 4

local function fnv(data: *[0]cchar, len: csize): uint64
  local h: uint64 = 14695981039346656037_u64
  local i: csize = 0
  while i < len do
    local c: uint8 = (@uint8)(data[i])
    h = (h ~ c) * 1099511628211_u64
    i = i + 1
  end
  return h
end

local function key_equal(json: *[0]cchar, start: csize,
                         key: *[0]cchar, key_len: csize): boolean
  local i: csize = 0
  while i < key_len do
    if json[start+i] ~= key[i] then return false end
    i = i + 1
  end
  return true
end

local function locate(json: *[0]cchar, json_len: csize,
                      key: *[0]cchar, key_len: csize,
                      value_pos: *csize): cint
  local wanted = fnv(key, key_len)
  local i: csize = 0
  while i < json_len do
    if json[i] ~= 34 then
      i = i + 1
      continue
    end

    local start = i + 1
    local j = start
    local h: uint64 = 14695981039346656037_u64
    local escaped = false
    while j < json_len do
      local c = json[j]
      if c == 92 then
        escaped = true
        j = j + 1
        if j >= json_len then return INVALID_JSON end
        j = j + 1
      elseif c == 34 then
        break
      elseif c >= 0 and c < 32 then
        return INVALID_JSON
      else
        h = (h ~ (@uint8)(c)) * 1099511628211_u64
        j = j + 1
      end
    end
    if j >= json_len then return INVALID_JSON end

    local after = melodica_skip_ws(json, json_len, j + 1)
    if not escaped and h == wanted and j - start == key_len and
       after < json_len and json[after] == 58 and
       key_equal(json, start, key, key_len) then
      $value_pos = after + 1
      return OK
    end
    i = j + 1
  end
  return NOT_FOUND
end

global function melodica_find_string(json: cstring <const>, json_len: csize,
                                     key: cstring <const>, key_len: csize,
                                     value_offset: *csize, value_len: *csize): cint
                                     <cexport, codename 'melodica_find_string'>
  if json == nilptr or key == nilptr or value_offset == nilptr or
     value_len == nilptr then return BAD_ARGUMENT end
  local json_bytes: *[0]cchar = (@*[0]cchar)(json)
  local key_bytes: *[0]cchar = (@*[0]cchar)(key)
  local pos: csize = 0
  local status = locate(json_bytes, json_len, key_bytes, key_len, &pos)
  if status ~= OK then return status end
  return melodica_parse_string_at(json_bytes, json_len, pos, value_offset, value_len)
end

global function melodica_find_bool(json: cstring <const>, json_len: csize,
                                   key: cstring <const>, key_len: csize,
                                   value: *cint): cint
                                   <cexport, codename 'melodica_find_bool'>
  if json == nilptr or key == nilptr or value == nilptr then return BAD_ARGUMENT end
  local json_bytes: *[0]cchar = (@*[0]cchar)(json)
  local key_bytes: *[0]cchar = (@*[0]cchar)(key)
  local pos: csize = 0
  local status = locate(json_bytes, json_len, key_bytes, key_len, &pos)
  if status ~= OK then return status end
  return melodica_parse_bool_at(json_bytes, json_len, pos, value)
end

global function melodica_find_u64(json: cstring <const>, json_len: csize,
                                  key: cstring <const>, key_len: csize,
                                  value: *uint64): cint
                                  <cexport, codename 'melodica_find_u64'>
  if json == nilptr or key == nilptr or value == nilptr then return BAD_ARGUMENT end
  local json_bytes: *[0]cchar = (@*[0]cchar)(json)
  local key_bytes: *[0]cchar = (@*[0]cchar)(key)
  local pos: csize = 0
  local status = locate(json_bytes, json_len, key_bytes, key_len, &pos)
  if status ~= OK then return status end
  return melodica_parse_u64_at(json_bytes, json_len, pos, value)
end

require 'src.track'
