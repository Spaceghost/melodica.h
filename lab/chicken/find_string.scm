(import scheme
        (chicken base)
        (chicken foreign)
        (chicken memory)
        (chicken platform))

(define LAB_OK 0)
(define LAB_NOT_FOUND 1)
(define LAB_INVALID_JSON 2)
(define LAB_BAD_ARGUMENT 4)

(define (ws? c)
  (or (char=? c #\space)
      (char=? c #\tab)
      (char=? c #\newline)
      (char=? c #\return)))

(define (hex? c)
  (or (char-numeric? c)
      (and (char>=? c #\a) (char<=? c #\f))
      (and (char>=? c #\A) (char<=? c #\F))))

(define (boundary? s pos)
  (or (>= pos (string-length s))
      (let ((c (string-ref s pos)))
        (or (ws? c) (char=? c #\,) (char=? c #\]) (char=? c #\})))))

(define (quote-escaped? s pos)
  (let loop ((i (- pos 1)) (n 0))
    (if (and (>= i 0) (char=? (string-ref s i) #\\))
        (loop (- i 1) (+ n 1))
        (odd? n))))

(define (skip-ws s pos)
  (let ((n (string-length s)))
    (let loop ((i pos))
      (if (and (< i n) (ws? (string-ref s i)))
          (loop (+ i 1))
          i))))

(define (same-key? json i key)
  (let ((kn (string-length key)))
    (let loop ((k 0))
      (cond ((= k kn) #t)
            ((char=? (string-ref json (+ i 1 k)) (string-ref key k))
             (loop (+ k 1)))
            (else #f)))))

(define (parse-string json pos)
  (let* ((n (string-length json))
         (p (skip-ws json pos)))
    (if (or (>= p n) (not (char=? (string-ref json p) #\")))
        (list LAB_INVALID_JSON 0 0)
        (let ((start (+ p 1)))
          (let loop ((i start))
            (if (>= i n)
                (list LAB_INVALID_JSON 0 0)
                (let ((c (string-ref json i)))
                  (cond
                    ((char=? c #\\)
                     (let ((e-pos (+ i 1)))
                       (if (>= e-pos n)
                           (list LAB_INVALID_JSON 0 0)
                           (let ((e (string-ref json e-pos)))
                             (if (char=? e #\u)
                                 (if (or (>= (+ e-pos 4) n)
                                         (not (hex? (string-ref json (+ e-pos 1))))
                                         (not (hex? (string-ref json (+ e-pos 2))))
                                         (not (hex? (string-ref json (+ e-pos 3))))
                                         (not (hex? (string-ref json (+ e-pos 4)))))
                                     (list LAB_INVALID_JSON 0 0)
                                     (loop (+ e-pos 5)))
                                 (if (or (char=? e #\") (char=? e #\\)
                                         (char=? e #\/) (char=? e #\b)
                                         (char=? e #\f) (char=? e #\n)
                                         (char=? e #\r) (char=? e #\t))
                                     (loop (+ e-pos 1))
                                     (list LAB_INVALID_JSON 0 0)))))))
                    ((char=? c #\")
                     (if (boundary? json (+ i 1))
                         (list LAB_OK start (- i start))
                         (list LAB_INVALID_JSON 0 0)))
                    ((< (char->integer c) #x20)
                     (list LAB_INVALID_JSON 0 0))
                    (else (loop (+ i 1)))))))))))

(define (locate json key)
  (let* ((n (string-length json))
         (kn (string-length key)))
    (if (> (+ kn 2) n)
        #f
        (let loop ((i 0))
          (if (> (+ i kn 2) n)
              #f
              (if (and (char=? (string-ref json i) #\")
                       (not (quote-escaped? json i))
                       (same-key? json i key)
                       (char=? (string-ref json (+ i 1 kn)) #\"))
                  (let ((after (skip-ws json (+ i kn 2))))
                    (if (and (< after n) (char=? (string-ref json after) #\:))
                        (+ after 1)
                        (loop (+ i 1))))
                  (loop (+ i 1))))))))

(define set-size-t!
  (foreign-lambda* void (((c-pointer size_t) p) (size_t value))
    "*p = value;"))

(define (copy-bytes p n)
  (let ((s (make-string n)))
    (move-memory! p s n)
    s))

(define-external (chicken_lab_find_string
                   (c-pointer json-p) (size_t json-n)
                   (c-pointer key-p) (size_t key-n)
                   ((c-pointer size_t) out-off)
                   ((c-pointer size_t) out-len))
  int
  (if (or (not json-p) (not key-p) (not out-off) (not out-len))
      LAB_BAD_ARGUMENT
      (let* ((json (copy-bytes json-p json-n))
             (key (copy-bytes key-p key-n))
             (pos (locate json key)))
        (if (not pos)
            LAB_NOT_FOUND
            (let ((parsed (parse-string json pos)))
              (if (= (car parsed) LAB_OK)
                  (begin
                    (set-size-t! out-off (cadr parsed))
                    (set-size-t! out-len (caddr parsed))
                    LAB_OK)
                  (car parsed)))))))

(return-to-host)
