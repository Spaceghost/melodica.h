module FindString;

export {findString};

inline bool is_ws(char ch)
{
    return((ch == ' ') || (ch == '\t') || (ch == '\n') || (ch == '\r'));
}

inline bool is_hex(char ch)
{
    return(((ch >= '0') && (ch <= '9')) ||
           ((ch >= 'a') && (ch <= 'f')) ||
           ((ch >= 'A') && (ch <= 'F')));
}

inline bool boundary(char[.] json, int n, int pos)
{
    if (pos >= n) {
        return(true);
    }
    ch = json[pos];
    return(is_ws(ch) || (ch == ',') || (ch == ']') || (ch == '}'));
}

inline int skip_ws(char[.] json, int n, int pos)
{
    while ((pos < n) && is_ws(json[pos])) {
        pos++;
    }
    return(pos);
}

inline bool quote_escaped(char[.] json, int pos)
{
    i = pos - 1;
    slashes = 0;
    while ((i >= 0) && (json[i] == '\\')) {
        slashes++;
        i--;
    }
    return((slashes % 2) != 0);
}

inline bool key_equal_at(char[.] json, char[.] key, int i, int kn)
{
    k = 0;
    while ((k < kn) && (json[i + 1 + k] == key[k])) {
        k++;
    }
    return(k == kn);
}

inline int[3] parse_string_value(char[.] json, int n, int pos)
{
    pos = skip_ws(json, n, pos);
    if ((pos >= n) || (json[pos] != '"')) {
        return([2, 0, 0]);
    }

    start = pos + 1;
    i = start;
    while (i < n) {
        ch = json[i];
        if (ch == '\\') {
            e = i + 1;
            if (e >= n) {
                return([2, 0, 0]);
            }
            esc = json[e];
            if (esc == 'u') {
                if (((e + 4) >= n) ||
                    !is_hex(json[e + 1]) || !is_hex(json[e + 2]) ||
                    !is_hex(json[e + 3]) || !is_hex(json[e + 4])) {
                    return([2, 0, 0]);
                }
                i = e + 5;
            } else {
                if (!((esc == '"') || (esc == '\\') || (esc == '/') ||
                      (esc == 'b') || (esc == 'f') || (esc == 'n') ||
                      (esc == 'r') || (esc == 't'))) {
                    return([2, 0, 0]);
                }
                i = e + 1;
            }
        } else if (ch == '"') {
            if (!boundary(json, n, i + 1)) {
                return([2, 0, 0]);
            }
            return([0, start, i - start]);
        } else {
            i++;
        }
    }

    return([2, 0, 0]);
}

int[3] findString(char[.] json, int n, char[.] key, int kn)
{
    if ((n < 0) || (kn < 0) || ((kn + 2) > n)) {
        return([1, 0, 0]);
    }

    i = 0;
    while ((i + kn + 2) <= n) {
        if ((json[i] == '"') &&
            !quote_escaped(json, i) &&
            key_equal_at(json, key, i, kn) &&
            (json[i + kn + 1] == '"')) {
            after = skip_ws(json, n, i + kn + 2);
            if ((after < n) && (json[after] == ':')) {
                return(parse_string_value(json, n, after + 1));
            }
        }
        i++;
    }

    return([1, 0, 0]);
}
