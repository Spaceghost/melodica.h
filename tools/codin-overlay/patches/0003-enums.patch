diff --git a/src/c99.c b/src/c99.c
--- a/src/c99.c
+++ b/src/c99.c
@@ -152,7 +152,17 @@ static Bool emit_expression(C99 *c, const Expression *expression) {
 	case EXPRESSION_SELECTOR: {
 		const SelectorExpression *selector = RCAST(const SelectorExpression *, expression);
 		if (!selector->operand) return unsupported(c, "implicit selector");
+		if (selector->operand->kind == EXPRESSION_IDENTIFIER) {
+			const Identifier *type_name =
+				RCAST(const IdentifierExpression *, selector->operand)->identifier;
+			const Type *named_type = sema_lookup_named_type(&c->sema, type_name->contents);
+			if (named_type && named_type->kind == TYPE_ENUM) {
+				fprintf(c->out, "%.*s_%.*s",
+				        SFMT(type_name->contents), SFMT(selector->identifier->contents));
+				return true;
+			}
+		}
 		if (!emit_expression(c, selector->operand)) return false;
 		fputc('.', c->out);
 		return emit_identifier(c, selector->identifier);
@@ -399,5 +409,29 @@ static Bool emit_struct_type(C99 *c, Identifier *name, const StructType *type) {
 	fprintf(c->out, "} %.*s;\n", SFMT(name->contents));
 	return true;
 }
+
+static Bool emit_enum_type(C99 *c, Identifier *name, const EnumType *type) {
+	if (!type->type) return unsupported(c, "enum without explicit backing type");
+	CType backing = sema_type_from_ast(type->type);
+	const char *backing_name = sema_c_type_name(backing);
+	if (!backing_name) return unsupported(c, "enum backing type");
+
+	fprintf(c->out, "typedef %s %.*s;\n", backing_name, SFMT(name->contents));
+	fputs("enum {\n", c->out);
+	const Size n_fields = array_size(type->fields);
+	for (Size i = 0; i < n_fields; i++) {
+		const Field *field = type->fields[i];
+		if (!field->name) return unsupported(c, "enum field");
+		fprintf(c->out, "    %.*s_%.*s",
+		        SFMT(name->contents), SFMT(field->name->contents));
+		if (field->value) {
+			fputs(" = ", c->out);
+			if (!emit_expression(c, field->value)) return false;
+		}
+		fputs(i + 1 < n_fields ? ",\n" : "\n", c->out);
+	}
+	fputs("};\n", c->out);
+	return true;
+}
 
 static Bool for_each_declaration(C99 *c, BuildContext *build, int phase) {
@@ -421,6 +455,10 @@ static Bool for_each_declaration(C99 *c, BuildContext *build, int phase) {
 				if (type && type->kind == TYPE_STRUCT) {
 					if (phase == 0 && !emit_struct_type(c, name, RCAST(const StructType *, type))) return false;
 					continue;
 				}
+				if (type && type->kind == TYPE_ENUM) {
+					if (phase == 0 && !emit_enum_type(c, name, RCAST(const EnumType *, type))) return false;
+					continue;
+				}
 				return unsupported(c, "top-level type declaration");
 			}
