{
  "name": "melodica-extension",
  "private": true,
  "type": "module",
  "description": "Pandora WebExtension (Chrome + Firefox, MV3): Imba UI, Nelua protocol core in WebAssembly",
  "license": "MIT",
  "scripts": {
    "build:core": "scripts/build-core.sh",
    "build": "node scripts/build.mjs",
    "test:core": "node core/test.mjs",
    "test:account": "node tests/account.test.mjs",
    "test:scrobble": "node tests/scrobble.test.mjs",
    "test:update": "node tests/update.test.mjs",
    "test:transfer": "node --test tests/playback-transfer.test.mjs tests/playback-copy.test.mjs",
    "test:smoke": "playwright test",
    "lint:firefox": "web-ext lint --source-dir dist/firefox --self-hosted",
    "package": "scripts/package.sh",
    "crx-id": "node scripts/crx-id.mjs",
    "test:firefox": "node tests/smoke-firefox.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "esbuild": "^0.25.0",
    "imba": "^2.0.0-alpha.253",
    "web-ext": "^8.0.0",
    "crx3": "^2.0.0",
    "selenium-webdriver": "^4.27.0"
  }
}
