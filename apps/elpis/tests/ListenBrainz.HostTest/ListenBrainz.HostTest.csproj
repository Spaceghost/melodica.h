<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Host checks for Elpis/ListenBrainz.cs (the scrobbler core is plain C# with no WPF), run on
    Linux: dotnet run (project tests/ListenBrainz.HostTest). With LB_SERVER and LB_TOKEN_FILE
    set it also submits to that server (a fake ListenBrainz, or a real one).
    Not part of Elpis.sln.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);SYSLIB0014</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Elpis/ListenBrainz.cs" Link="ListenBrainz.cs" />
  </ItemGroup>
</Project>
