{
  "app-id": "io.github.Pithos",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "command": "pithos",
  "finish-args": [
    "--share=ipc",
    "--share=network",
    "--socket=fallback-x11",
    "--socket=x11",
    "--socket=wayland",
    "--socket=pulseaudio",
    "--metadata=X-DConf=migrate-path=/io/github/Pithos/",
    "--talk-name=org.gnome.SettingsDaemon.MediaKeys",
    "--talk-name=org.mate.SettingsDaemon",
    "--talk-name=org.kde.StatusNotifierWatcher",
    "--env=MELODICA_LIBRARY=/app/lib/libmelodica.so"
  ],
  "modules": [
    "python3-pylast.json",
    {
      "name": "keybinder",
      "cleanup": ["/lib/*.la", "/include", "/share", "/lib/pkgconfig"],
      "sources": [{
        "type": "archive",
        "url": "https://github.com/kupferlauncher/keybinder/releases/download/keybinder-3.0-v0.3.2/keybinder-3.0-0.3.2.tar.gz",
        "sha256": "e6e3de4e1f3b201814a956ab8f16dfc8a262db1937ff1eee4d855365398c6020"
      }]
    },
    {
      "name": "melodica",
      "buildsystem": "simple",
      "build-commands": [
        "cc -O3 -std=c99 -pedantic-errors -Wall -Wextra -Werror -fPIC -shared -Iinclude impl/c/melodica.c -o libmelodica.so",
        "install -Dm755 libmelodica.so /app/lib/libmelodica.so",
        "install -Dm644 include/melodica.h /app/include/melodica.h",
        "install -Dm644 LICENSE.libpiano /app/share/licenses/melodica/LICENSE.libpiano"
      ],
      "sources": [{
        "type": "dir",
        "path": "../vendor/melodica.h"
      }]
    },
    {
      "name": "pithos",
      "builddir": true,
      "buildsystem": "meson",
      "cleanup": ["/share/man"],
      "post-install": [
        "sed -i 's|^Exec=.*|Exec=pithos %u|' /app/share/applications/io.github.Pithos.desktop"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../"
        }
      ]
    }
  ]
}
