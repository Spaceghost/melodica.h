-- Zero-copy station view. Like tracks, strings remain slices into caller-owned
-- JSON and a present mask distinguishes absent fields from empty values.
require 'src.types'

local OK: cint <comptime> = 0
local NOT_FOUND: cint <comptime> = 1
local BAD_ARGUMENT: cint <comptime> = 4

local STATION_ID: uint32 <comptime> = 1
local PANDORA_ID: uint32 <comptime> = 2
local ART_ID: uint32 <comptime> = 4
local NAME: uint32 <comptime> = 8
local CREATOR_WEBNAME: uint32 <comptime> = 16

local function station_clear_slice(dst: *melodica_slice)
  dst.offset = 0
  dst.length = 0
end

local function station_capture_string(json: cstring <const>, json_len: csize,
                                      key: cstring <const>, key_len: csize,
                                      dst: *melodica_slice,
                                      station: *melodica_station_view,
                                      flag: uint32): cint
  local offset: csize = 0
  local length: csize = 0
  local status = melodica_find_string(json, json_len, key, key_len,
                                      &offset, &length)
  if status == OK then
    dst.offset = offset
    dst.length = length
    station.present = station.present | flag
    return OK
  end
  if status == NOT_FOUND then return OK end
  return status
end

global function melodica_parse_station(json: cstring <const>, json_len: csize,
                                       station: *melodica_station_view): cint
                                       <cexport, codename 'melodica_parse_station'>
  if json == nilptr or station == nilptr then return BAD_ARGUMENT end

  station.present = 0
  station_clear_slice(&station.station_id)
  station_clear_slice(&station.pandora_id)
  station_clear_slice(&station.art_id)
  station_clear_slice(&station.name)
  station_clear_slice(&station.creator_webname)

  local status = station_capture_string(json, json_len, "stationId", 9,
                                        &station.station_id, station, STATION_ID)
  if status ~= OK then return status end
  status = station_capture_string(json, json_len, "pandoraId", 9,
                                  &station.pandora_id, station, PANDORA_ID)
  if status ~= OK then return status end
  status = station_capture_string(json, json_len, "artId", 5,
                                  &station.art_id, station, ART_ID)
  if status ~= OK then return status end
  status = station_capture_string(json, json_len, "name", 4,
                                  &station.name, station, NAME)
  if status ~= OK then return status end
  status = station_capture_string(json, json_len, "creatorWebname", 14,
                                  &station.creator_webname, station,
                                  CREATOR_WEBNAME)
  if status ~= OK then return status end

  return OK
end
