-- Shared request writers. Everything is caller-buffered; no allocator or
-- runtime state is required.

local OK: cint <comptime> = 0
local NO_SPACE: cint <comptime> = 3
local BAD_ARGUMENT: cint <comptime> = 4

local function putc(output: *[0]cchar, output_cap: csize,
                    pos: *csize, c: cchar): boolean
  if $pos >= output_cap then return false end
  output[$pos] = c
  $pos = $pos + 1
  return true
end

local function append(output: *[0]cchar, output_cap: csize, pos: *csize,
                      input: cstring <const>, input_len: csize): boolean
  local bytes: *[0]cchar = (@*[0]cchar)(input)
  if $pos > output_cap or input_len > output_cap - $pos then return false end
  local i: csize = 0
  while i < input_len do
    output[$pos] = bytes[i]
    $pos = $pos + 1
    i = i + 1
  end
  return true
end

local function append_u64(output: *[0]cchar, output_cap: csize, pos: *csize,
                          value: uint64): boolean
  local divisor: uint64 = 1
  local remaining = value
  while remaining >= 10 do
    remaining = remaining // 10
    divisor = divisor * 10
  end

  while divisor > 0 do
    local digit: cchar = (@cchar)(48 + (value // divisor) % 10)
    if not putc(output, output_cap, pos, digit) then return false end
    divisor = divisor // 10
  end
  return true
end

local function append_bool(output: *[0]cchar, output_cap: csize, pos: *csize,
                           value: cint): boolean
  if value ~= 0 then
    return append(output, output_cap, pos, "true", 4)
  end
  return append(output, output_cap, pos, "false", 5)
end

local function hex_digit(v: uint8): cchar
  if v < 10 then return (@cchar)(48 + v) end
  return (@cchar)(87 + v)
end

local function append_escaped(output: *[0]cchar, output_cap: csize, pos: *csize,
                              input: *[0]cchar, input_len: csize): boolean
  local i: csize = 0
  while i < input_len do
    local c = input[i]
    if c == 34 or c == 92 then
      if not putc(output, output_cap, pos, 92) or
         not putc(output, output_cap, pos, c) then return false end
    elseif c == 8 then
      if not append(output, output_cap, pos, "\\b", 2) then return false end
    elseif c == 12 then
      if not append(output, output_cap, pos, "\\f", 2) then return false end
    elseif c == 10 then
      if not append(output, output_cap, pos, "\\n", 2) then return false end
    elseif c == 13 then
      if not append(output, output_cap, pos, "\\r", 2) then return false end
    elseif c == 9 then
      if not append(output, output_cap, pos, "\\t", 2) then return false end
    elseif c >= 0 and c < 32 then
      if not append(output, output_cap, pos, "\\u00", 4) then return false end
      local u: uint8 = (@uint8)(c)
      if not putc(output, output_cap, pos, hex_digit(u // 16)) or
         not putc(output, output_cap, pos, hex_digit(u % 16)) then return false end
    else
      if not putc(output, output_cap, pos, c) then return false end
    end
    i = i + 1
  end
  return true
end

local function version(): cuint <cexport, codename 'melodica_version'>
  return 1024 -- 0.4.0
end

local function json_escape(input: cstring <const>, input_len: csize,
                           output: *[0]cchar, output_cap: csize,
                           output_len: *csize): cint
                           <cexport, codename 'melodica_json_escape'>
  if input == nilptr or output == nilptr or output_len == nilptr then
    return BAD_ARGUMENT
  end
  local input_bytes: *[0]cchar = (@*[0]cchar)(input)
  local pos: csize = 0
  if not append_escaped(output, output_cap, &pos, input_bytes, input_len) then
    $output_len = pos
    return NO_SPACE
  end
  $output_len = pos
  return OK
end

local function login_body(username: cstring <const>, username_len: csize,
                          password: cstring <const>, password_len: csize,
                          output: *[0]cchar, output_cap: csize,
                          output_len: *csize): cint
                          <cexport, codename 'melodica_login_body'>
  if username == nilptr or password == nilptr or
     output == nilptr or output_len == nilptr then return BAD_ARGUMENT end
  local username_bytes: *[0]cchar = (@*[0]cchar)(username)
  local password_bytes: *[0]cchar = (@*[0]cchar)(password)
  local pos: csize = 0
  if not append(output, output_cap, &pos, "{\"username\":\"", 13) or
     not append_escaped(output, output_cap, &pos, username_bytes, username_len) or
     not append(output, output_cap, &pos, "\",\"password\":\"", 14) or
     not append_escaped(output, output_cap, &pos, password_bytes, password_len) or
     not append(output, output_cap, &pos, "\"}", 2) then
    $output_len = pos
    return NO_SPACE
  end
  $output_len = pos
  return OK
end

local function stations_body(page_size: cuint, start_index: cuint,
                             output: *[0]cchar, output_cap: csize,
                             output_len: *csize): cint
                             <cexport, codename 'melodica_stations_body'>
  if output == nilptr or output_len == nilptr then return BAD_ARGUMENT end
  local pos: csize = 0
  if not append(output, output_cap, &pos, "{\"pageSize\":", 12) or
     not append_u64(output, output_cap, &pos, (@uint64)(page_size)) or
     not append(output, output_cap, &pos, ",\"startIndex\":", 14) or
     not append_u64(output, output_cap, &pos, (@uint64)(start_index)) or
     not putc(output, output_cap, &pos, 125) then
    $output_len = pos
    return NO_SPACE
  end
  $output_len = pos
  return OK
end

local function playlist_body(station_id: cstring <const>, station_id_len: csize,
                             station_start: cint,
                             audio_format: cstring <const>, audio_format_len: csize,
                             output: *[0]cchar, output_cap: csize,
                             output_len: *csize): cint
                             <cexport, codename 'melodica_playlist_body'>
  if station_id == nilptr or audio_format == nilptr or
     output == nilptr or output_len == nilptr then return BAD_ARGUMENT end
  local station_bytes: *[0]cchar = (@*[0]cchar)(station_id)
  local format_bytes: *[0]cchar = (@*[0]cchar)(audio_format)
  local pos: csize = 0
  if not append(output, output_cap, &pos, "{\"stationId\":\"", 14) or
     not append_escaped(output, output_cap, &pos, station_bytes, station_id_len) or
     not append(output, output_cap, &pos, "\",\"isStationStart\":", 19) or
     not append_bool(output, output_cap, &pos, station_start) or
     not append(output, output_cap, &pos,
                ",\"fragmentRequestReason\":\"Normal\",\"audioFormat\":\"", 49) or
     not append_escaped(output, output_cap, &pos, format_bytes, audio_format_len) or
     not append(output, output_cap, &pos, "\"}", 2) then
    $output_len = pos
    return NO_SPACE
  end
  $output_len = pos
  return OK
end

local function feedback_body(track_token: cstring <const>, track_token_len: csize,
                             positive: cint,
                             output: *[0]cchar, output_cap: csize,
                             output_len: *csize): cint
                             <cexport, codename 'melodica_feedback_body'>
  if track_token == nilptr or output == nilptr or output_len == nilptr then
    return BAD_ARGUMENT
  end
  local token_bytes: *[0]cchar = (@*[0]cchar)(track_token)
  local pos: csize = 0
  if not append(output, output_cap, &pos, "{\"trackToken\":\"", 15) or
     not append_escaped(output, output_cap, &pos, token_bytes, track_token_len) or
     not append(output, output_cap, &pos, "\",\"isPositive\":", 15) or
     not append_bool(output, output_cap, &pos, positive) or
     not putc(output, output_cap, &pos, 125) then
    $output_len = pos
    return NO_SPACE
  end
  $output_len = pos
  return OK
end

local function tired_body(track_token: cstring <const>, track_token_len: csize,
                          output: *[0]cchar, output_cap: csize,
                          output_len: *csize): cint
                          <cexport, codename 'melodica_tired_body'>
  if track_token == nilptr or output == nilptr or output_len == nilptr then
    return BAD_ARGUMENT
  end
  local token_bytes: *[0]cchar = (@*[0]cchar)(track_token)
  local pos: csize = 0
  if not append(output, output_cap, &pos, "{\"trackToken\":\"", 15) or
     not append_escaped(output, output_cap, &pos, token_bytes, track_token_len) or
     not append(output, output_cap, &pos, "\"}", 2) then
    $output_len = pos
    return NO_SPACE
  end
  $output_len = pos
  return OK
end

local function narrative_body(station_id: cstring <const>, station_id_len: csize,
                              music_id: cstring <const>, music_id_len: csize,
                              output: *[0]cchar, output_cap: csize,
                              output_len: *csize): cint
                              <cexport, codename 'melodica_narrative_body'>
  if station_id == nilptr or music_id == nilptr or
     output == nilptr or output_len == nilptr then return BAD_ARGUMENT end
  local station_bytes: *[0]cchar = (@*[0]cchar)(station_id)
  local music_bytes: *[0]cchar = (@*[0]cchar)(music_id)
  local pos: csize = 0
  if not append(output, output_cap, &pos, "{\"musicId\":\"", 12) or
     not append_escaped(output, output_cap, &pos, music_bytes, music_id_len) or
     not append(output, output_cap, &pos, "\",\"stationId\":\"", 15) or
     not append_escaped(output, output_cap, &pos, station_bytes, station_id_len) or
     not append(output, output_cap, &pos, "\"}", 2) then
    $output_len = pos
    return NO_SPACE
  end
  $output_len = pos
  return OK
end

local function track_started_body(track_token: cstring <const>,
                                  track_token_len: csize,
                                  output: *[0]cchar, output_cap: csize,
                                  output_len: *csize): cint
                                  <cexport, codename 'melodica_track_started_body'>
  if track_token == nilptr or output == nilptr or output_len == nilptr then
    return BAD_ARGUMENT
  end
  local token_bytes: *[0]cchar = (@*[0]cchar)(track_token)
  local pos: csize = 0
  if not append(output, output_cap, &pos, "{\"trackToken\":\"", 15) or
     not append_escaped(output, output_cap, &pos, token_bytes, track_token_len) or
     not append(output, output_cap, &pos, "\"}", 2) then
    $output_len = pos
    return NO_SPACE
  end
  $output_len = pos
  return OK
end

local function playback_paused_body(sync: cint,
                                    output: *[0]cchar, output_cap: csize,
                                    output_len: *csize): cint
                                    <cexport, codename 'melodica_playback_paused_body'>
  if output == nilptr or output_len == nilptr then return BAD_ARGUMENT end
  local pos: csize = 0
  if not append(output, output_cap, &pos, "{\"sync\":", 8) or
     not append_bool(output, output_cap, &pos, sync) or
     not putc(output, output_cap, &pos, 125) then
    $output_len = pos
    return NO_SPACE
  end
  $output_len = pos
  return OK
end

local function station_details_body(station_id: cstring <const>,
                                    station_id_len: csize,
                                    is_current_station: cint,
                                    output: *[0]cchar, output_cap: csize,
                                    output_len: *csize): cint
                                    <cexport, codename 'melodica_station_details_body'>
  if station_id == nilptr or output == nilptr or output_len == nilptr then
    return BAD_ARGUMENT
  end
  local station_bytes: *[0]cchar = (@*[0]cchar)(station_id)
  local pos: csize = 0
  if not append(output, output_cap, &pos, "{\"stationId\":\"", 14) or
     not append_escaped(output, output_cap, &pos, station_bytes, station_id_len) or
     not append(output, output_cap, &pos, "\",\"isCurrentStation\":", 21) or
     not append_bool(output, output_cap, &pos, is_current_station) or
     not putc(output, output_cap, &pos, 125) then
    $output_len = pos
    return NO_SPACE
  end
  $output_len = pos
  return OK
end

local function station_feedback_body(station_id: cstring <const>,
                                     station_id_len: csize,
                                     page_size: cuint, start_index: cuint,
                                     positive: cint,
                                     output: *[0]cchar, output_cap: csize,
                                     output_len: *csize): cint
                                     <cexport, codename 'melodica_station_feedback_body'>
  if station_id == nilptr or output == nilptr or output_len == nilptr then
    return BAD_ARGUMENT
  end
  local station_bytes: *[0]cchar = (@*[0]cchar)(station_id)
  local pos: csize = 0
  if not append(output, output_cap, &pos, "{\"pageSize\":", 12) or
     not append_u64(output, output_cap, &pos, (@uint64)(page_size)) or
     not append(output, output_cap, &pos, ",\"startIndex\":", 14) or
     not append_u64(output, output_cap, &pos, (@uint64)(start_index)) or
     not append(output, output_cap, &pos, ",\"stationId\":\"", 14) or
     not append_escaped(output, output_cap, &pos, station_bytes, station_id_len) or
     not append(output, output_cap, &pos, "\",\"positive\":", 13) or
     not append_bool(output, output_cap, &pos, positive) or
     not putc(output, output_cap, &pos, 125) then
    $output_len = pos
    return NO_SPACE
  end
  $output_len = pos
  return OK
end
